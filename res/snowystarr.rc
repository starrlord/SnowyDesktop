#include <winres.h>
#include "resource.h"

IDI_APP         ICON    "snowystarr.ico"
IDI_APP_PAUSED  ICON    "snowystarr_paused.ico"

IDR_CLASSIC1    RCDATA  "classic/flake1.png"
IDR_CLASSIC2    RCDATA  "classic/flake2.png"
IDR_CLASSIC3    RCDATA  "classic/flake3.png"
IDR_CLASSIC4    RCDATA  "classic/flake4.png"
IDR_CLASSIC5    RCDATA  "classic/flake5.png"
IDR_CLASSIC6    RCDATA  "classic/flake6.png"
IDR_CLASSIC7    RCDATA  "classic/flake7.png"
IDR_CLASSIC8    RCDATA  "classic/flake8.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     SNOWYSTARR_VERSION_MAJOR, SNOWYSTARR_VERSION_MINOR, SNOWYSTARR_VERSION_PATCH, 0
 PRODUCTVERSION  SNOWYSTARR_VERSION_MAJOR, SNOWYSTARR_VERSION_MINOR, SNOWYSTARR_VERSION_PATCH, 0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Joshua Starr"
            VALUE "FileDescription",  "Snowy Desktop"
            VALUE "FileVersion",      SNOWYSTARR_VERSION_STR
            VALUE "InternalName",     "snowystarr"
            VALUE "OriginalFilename", "snowystarr.exe"
            VALUE "ProductName",      "Snowy Desktop"
            VALUE "ProductVersion",   SNOWYSTARR_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
